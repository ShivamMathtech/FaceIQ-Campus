# Generate the actual key using scripts/configure.py. Keep it outside source control.
ENCRYPTION_KEY=
# If omitted, SQLite uses <project>/storage/faceiq.db.
# DATABASE_URL=postgresql+psycopg://faceiq:YOUR_PASSWORD@localhost:5432/faceiq
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
TOKEN_MINUTES=60
INFERENCE_INTERVAL_MS=800
FRAME_MAX_WIDTH=960
CV_THREADS=2
MAX_UPLOAD_MB=5
# Optional absolute path; omitted uses <project>/storage/models.
# MODEL_DIR=C:/FaceIQ-Campus/storage/models
